# =============================================================================
# Staging / pruebas en VPS (Docker Compose + subdominio único)
# Copiar en el servidor: cp .env.staging.example .env
# Ajustar STAGING_DOMAIN y secretos antes de: make staging
# Guía: docs/deploy/staging-vps-docker.md
# =============================================================================

APP_NAME=Cotizacion
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_DEMO_MODE=false

# Subdominio único: SPA (/spa/) y API (/api) en el mismo host
# Local sin DNS: http://localhost
# Con dominio: https://cotizacion.tudominio.com
STAGING_DOMAIN=cotizacion.tudominio.com
APP_URL=https://${STAGING_DOMAIN}
FRONTEND_URL=https://${STAGING_DOMAIN}

APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=info

# Puertos Docker (frontend = cara pública en staging)
APP_PORT=8080
FRONTEND_PORT=80
POSTGRES_PORT=5432

# PostgreSQL (servicio postgres en docker-compose)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cotizacion
DB_USERNAME=cotizacion
DB_PASSWORD=change_me_staging_db

# Sanctum + sesión (mismo origen)
SANCTUM_STATEFUL_DOMAINS=${STAGING_DOMAIN}
VITE_API_URL=/api
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=${STAGING_DOMAIN}
SESSION_PATH=/

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Mayoristas — desactivar demo en staging; CT es el piloto de integración
WHOLESALER_DEMO_OFFERS=false
WHOLESALER_COMPARE_CODES=CT,CVA

# CT Connect — https://api.ctonline.mx/documentacion.html
WHOLESALER_CT_BASE_URL=https://api.ctonline.mx:3001
# Sandbox (pruebas): WHOLESALER_CT_BASE_URL=https://api.ctonline.mx:4000
# Token fijo (recomendado) O generación automática con email+cliente+rfc:
WHOLESALER_CT_API_KEY=
# WHOLESALER_CT_EMAIL=
# WHOLESALER_CT_CLIENTE=
# WHOLESALER_CT_RFC=
WHOLESALER_CT_LOOKUP_PATH=/existencia/promociones/{part_number}
WHOLESALER_CT_SOURCE_IP=2.25.78.222
WHOLESALER_CT_TIMEOUT=20
# Catálogo FTP — obligatorio para autocomplete (SKU y descripción a la vez = AND)
WHOLESALER_CT_FTP_HOST=
WHOLESALER_CT_FTP_USER=
WHOLESALER_CT_FTP_PASSWORD=
WHOLESALER_CT_FTP_PATH=/catalogo_xml/productos.json
WHOLESALER_CT_FTP_EXTRA_PATHS=/catalogo_xml/productos_especiales_PAZ0074.xml
WHOLESALER_CT_CATALOG_TTL=15
# Modelo fabricante → clave CT cuando falta en FTP (además de config/ct_part_aliases.php)
# WHOLESALER_CT_PART_ALIASES=CZ103AL:CARHPP2110

# Otros mayoristas — ver docs/integraciones/mayoristas-credenciales.md
WHOLESALER_INGRAM_BASE_URL=
WHOLESALER_INGRAM_API_KEY=
WHOLESALER_INGRAM_LOOKUP_PATH=/products/{part_number}
WHOLESALER_INGRAM_TIMEOUT=20
# WHOLESALER_INGRAM_AUTH_HEADER=Authorization

WHOLESALER_EXEL_BASE_URL=
WHOLESALER_EXEL_API_KEY=
# WHOLESALER_EXEL_CSV_PATH=

# n8n + Docling (perfil integrations: docker compose ... --profile integrations up -d)
N8N_BASE_URL=http://n8n:5678
# URL del webhook EN n8n que Laravel dispara (red Docker; path según workflow importado)
N8N_WEBHOOK_URL=http://n8n:5678/webhook/lectura-docling
N8N_COMPARATOR_WEBHOOK_URL=http://n8n:5678/webhook/comparador-precios
# URL pública de n8n (UI / webhooks externos); con dominio: https://n8n.tudominio.com o puerto 5678
N8N_WEBHOOK_BASE=http://${STAGING_DOMAIN}:5678
N8N_PORT=5678
N8N_DB_DATABASE=n8n
N8N_API_KEY=
N8N_TIMEOUT=120
N8N_WEBHOOK_SECRET=change_me_n8n_webhook_secret

DOCLING_BASE_URL=http://docling-serve:5001
DOCLING_TIMEOUT=180

QUOTE_DEFAULT_MARGIN=30
QUOTE_DEFAULT_TAX=16
QUOTE_DEFAULT_VALIDITY_DAYS=15

# Correo (opcional en staging)
MAIL_MAILER=smtp
MAIL_HOST=smtp.tudominio.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="cotizaciones@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
