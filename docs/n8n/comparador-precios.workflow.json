    },
    {
      "parameters": {
        "url": "http://nginx/api/n8n/mayoristas?active=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "X-N8N-Webhook-Secret",
