          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { fuente: 'n8n', tipo: 'solicitud_cotizacion', contenido: { lineas: [] }, metadata: { request_id: $('Normalizar interpretar').first().json.request_id, source: $('Normalizar interpretar').first().json.source, error: $json.error_message || $json.message || 'El archivo no cumple el formato requerido.', interpretacion_via: 'parser' } } }}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
