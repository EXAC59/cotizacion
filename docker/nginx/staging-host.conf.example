# Plantilla Nginx en el HOST (VPS) delante de Docker staging
# Copiar a /etc/nginx/sites-available/cotizacion-staging
# Reemplazar cotizacion.tudominio.com y rutas de certificado SSL

server {
    listen 80;
    server_name cotizacion.tudominio.com;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        client_max_body_size 64M;
    }
}

