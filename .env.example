APP_NAME=Cotizacion
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://cotizacion.test
# Docker: http://localhost:8080  (ver .env.docker.example)
APP_PORT=8080
FRONTEND_PORT=5173
APP_TIMEZONE=America/Mexico_City

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laragon sin PostgreSQL: modo demo (recomendado para empezar)
APP_DEMO_MODE=true
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Producción / Docker con PostgreSQL:
# APP_DEMO_MODE=false
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=cotizacion
# DB_USERNAME=cotizacion
# DB_PASSWORD=secret

# Comparador: false en prod/VPS (sin Ingram/Exel inventados). true solo en local de pruebas.
WHOLESALER_DEMO_OFFERS=false
# Limitar a mayoristas con API real (vacío = todos los activos)
WHOLESALER_COMPARE_CODES=CT

# Ejemplo Ingram Micro (API REST):
# WHOLESALER_INGRAM_BASE_URL=https://api.ingrammicro.com
# WHOLESALER_INGRAM_API_KEY=
# WHOLESALER_INGRAM_LOOKUP_PATH=/products/{part_number}

# Exel del Norte (CSV local o URL):
# WHOLESALER_EXEL_CSV_PATH=wholesalers/exel.csv
# WHOLESALER_EXEL_BASE_URL=
# WHOLESALER_EXEL_CSV_TTL=15

# CT Internacional (piloto integración — ver docs/deploy/ct-internacional.md):
# WHOLESALER_CT_BASE_URL=
# WHOLESALER_CT_API_KEY=
# WHOLESALER_CT_LOOKUP_PATH=/existencia/promociones/{part_number}
# WHOLESALER_CT_SOURCE_IP=
# WHOLESALER_CT_TIMEOUT=20
# Catálogo FTP (autocomplete SKU∩descripción en Docker api) — docs/deploy/ct-internacional.md
# WHOLESALER_CT_FTP_HOST=
# WHOLESALER_CT_FTP_USER=
# WHOLESALER_CT_FTP_PASSWORD=
# WHOLESALER_CT_FTP_PATH=/catalogo_xml/productos.json
# WHOLESALER_CT_FTP_EXTRA_PATHS=/catalogo_xml/productos_especiales_PAZ0074.xml
# WHOLESALER_CT_CATALOG_TTL=15
# WHOLESALER_CT_PART_ALIASES=
#
# Sincronizar catálogo: php artisan wholesalers:sync-catalog
# Prueba CT: php artisan wholesalers:test-ct SKU-EJEMPLO
# Autocomplete AND: GET /api/mayoristas/ct/autocomplete?sku=...&descripcion=...

# Staging / VPS Docker: ver .env.staging.example y docs/deploy/staging-vps-docker.md

N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/lectura-docling
# En Docker (VPS): usa http://n8n:5678/... — localhost no alcanza el contenedor n8n desde api.
N8N_COMPARATOR_WEBHOOK_URL=http://localhost:5678/webhook/comparador-precios
N8N_WEBHOOK_BASE=http://localhost:5678
N8N_PORT=5678
N8N_DB_DATABASE=n8n
N8N_API_KEY=
N8N_TIMEOUT=120
COMPARATOR_POLL_TIMEOUT=60
COMPARATOR_FALLBACK_SECONDS=20
N8N_WEBHOOK_SECRET=

# WhatsApp Cloud API (Meta) — envío/webhook cotizaciones
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WABA_ID=
# WHATSAPP_VERIFY_TOKEN=
# App Secret de Meta (requerido para POST del webhook; firma X-Hub-Signature-256)
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v21.0
# Webhook público: GET/POST https://tu-dominio/api/whatsapp/webhook

# Motor de profit — margen e IVA predeterminados (Objetivo 4)
QUOTE_DEFAULT_MARGIN=30
QUOTE_DEFAULT_TAX=16
QUOTE_DEFAULT_VALIDITY_DAYS=15

# Docling Serve — lectura PDF / Excel / Word + OCR (local Docker puerto 5001)
DOCLING_BASE_URL=http://127.0.0.1:5001
DOCLING_PORT=5001
DOCLING_TIMEOUT=180
DOCLING_DO_OCR=true
DOCLING_OCR_LANGS=es,en
DOCLING_TABLE_MODE=accurate

# Frontend React (Vite)
FRONTEND_URL=http://localhost:5173
# SPA + Sanctum: dominios stateful (prod: tu dominio sin protocolo)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,cotizacion.test
# Minutos de vida de tokens bearer (SPA usa cookie de sesión; tokens spa ya no se emiten)
SANCTUM_TOKEN_EXPIRATION=480
# Producción: APP_DEMO_MODE=false, APP_DEBUG=false, SESSION_ENCRYPT=true, HTTPS
VITE_API_URL=/api

SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# PDF cotizaciones: ejecutar `php artisan storage:link` para servir logotipo en /storage/company/
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.tudominio.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="cotizaciones@exacto.com.mx"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
